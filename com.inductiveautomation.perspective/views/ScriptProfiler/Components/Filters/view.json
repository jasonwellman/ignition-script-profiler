              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tcurrent_year \u003d system.date.getYear(system.date.now())\n\tdate \u003d system.date.getDate(current_year, 0, 1)\n\n\tself.session.custom.scriptProfiler.filters.dateStart \u003d system.date.addYears(date, -10)\n\tself.session.custom.scriptProfiler.filters.dateEnd \u003d system.date.addYears(date, +1)\n\tself.session.custom.scriptProfiler.filters.scriptName \u003d None\n\tself.session.custom.scriptProfiler.filters.scriptType \u003d None\n\tself.session.custom.scriptProfiler.filters.commentFilter \u003d None"
