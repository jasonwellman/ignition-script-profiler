{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 1000,
      "width": 1200
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "EquipmentSchedule"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.dateRange.endDate": {
            "binding": {
              "config": {
                "path": "session.custom.scriptProfiler.filters.dateEnd"
              },
              "type": "property"
            }
          },
          "props.dateRange.startDate": {
            "binding": {
              "config": {
                "path": "session.custom.scriptProfiler.filters.dateStart"
              },
              "type": "property"
            }
          },
          "props.items": {
            "binding": {
              "config": {
                "mode": "direct",
                "parameters": {
                  "date_end": "{session.custom.scriptProfiler.filters.dateEnd}",
                  "date_start": "{session.custom.scriptProfiler.filters.dateStart}",
                  "script_name": "{session.custom.scriptProfiler.queryPayload.scriptName}",
                  "script_type": "{session.custom.scriptProfiler.queryPayload.scriptType}"
                },
                "polling": {
                  "enabled": true,
                  "rate": "60"
                },
                "queryPath": "scriptProfiler/getHistoryForEquipmentScheduleComponentDistinctItems",
                "returnFormat": "json"
              },
              "type": "query"
            }
          },
          "props.scheduledEvents": {
            "binding": {
              "config": {
                "mode": "direct",
                "parameters": {
                  "date_end": "{session.custom.scriptProfiler.filters.dateEnd}",
                  "date_start": "{session.custom.scriptProfiler.filters.dateStart}",
                  "script_name": "{session.custom.scriptProfiler.queryPayload.scriptName}",
                  "script_type": "{session.custom.scriptProfiler.queryPayload.scriptType}"
                },
                "polling": {
                  "enabled": true,
                  "rate": "5"
                },
                "queryPath": "scriptProfiler/getHistoryForEquipmentScheduleComponent",
                "returnFormat": "json"
              },
              "type": "query"
            }
          }
        },
        "props": {
          "addEnabled": false,
          "clickEnabled": false,
          "dateRange": {},
          "deleteEnabled": false,
          "moveEnabled": false,
          "progressBar": {
            "enabled": false
          },
          "resizeEnabled": false,
          "rowHeight": 40,
          "scheduledEventStyle": {
            "backgroundColor": "--success",
            "borderBottomLeftRadius": 3,
            "borderBottomRightRadius": 3,
            "borderStyle": "solid",
            "borderTopLeftRadius": 3,
            "borderTopRightRadius": 3,
            "borderWidth": 0
          },
          "selectedEvent": {}
        },
        "type": "ia.display.equipmentschedule"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}