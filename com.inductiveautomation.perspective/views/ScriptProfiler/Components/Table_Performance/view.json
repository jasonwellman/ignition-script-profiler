          "custom.table_metrics": {
            "binding": {
              "config": {
                "path": "this.props.data"
              },
              "transforms": [
                {
                  "code": "\tif value is None or value.rowCount \u003d\u003d 0:\n\t\treturn {\n\t\t\t\"duration_min\": {\"min\": 0, \"max\": 0},\n\t\t\t\"duration_avg\": {\"min\": 0, \"max\": 0},\n\t\t\t\"duration_max\": {\"min\": 0, \"max\": 0}\n\t\t}\n\t\n\tpy_ds \u003d system.dataset.toPyDataSet(value)\n\t\n\tmin_list \u003d [row[\"min_duration_ms\"] for row in py_ds if row[\"min_duration_ms\"] is not None]\n\tavg_list \u003d [row[\"avg_duration_ms\"] for row in py_ds if row[\"avg_duration_ms\"] is not None]\n\tmax_list \u003d [row[\"max_duration_ms\"] for row in py_ds if row[\"max_duration_ms\"] is not None]\n\t\n\treturn {\n\t\t\"duration_min\": {\n\t\t\t\"min\": min(min_list) if min_list else 0,\n\t\t\t\"max\": max(min_list) if min_list else 0\n\t\t},\n\t\t\"duration_avg\": {\n\t\t\t\"min\": min(avg_list) if avg_list else 0,\n\t\t\t\"max\": max(avg_list) if avg_list else 0\n\t\t},\n\t\t\"duration_max\": {\n\t\t\t\"min\": min(max_list) if max_list else 0,\n\t\t\t\"max\": max(max_list) if max_list else 0\n\t\t}\n\t}",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.columns[4].progressBar.max": {
            "binding": {
              "config": {
                "path": "this.custom.table_metrics.duration_min.max"
              },
              "type": "property"
