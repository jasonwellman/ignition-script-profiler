        "propConfig": {
          "custom.query_polling": {
            "binding": {
              "config": {
                "expression": "len({this.props.data})"
              },
              "transforms": [
                {
                  "fallback": 10,
                  "inputType": "range",
                  "mappings": [
                    {
                      "input": {
                        "max": 1000,
                        "min": 0
                      },
                      "output": 1
                    },
                    {
                      "input": {
                        "max": 5000,
                        "min": 1001
                      },
                      "output": 5
                    },
                    {
                      "input": {
                        "max": 10000,
                        "min": 5000
                      },
                      "output": 15
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                },
                {
                  "expression": "if({../FlexContainer_Header/Auto_Update.custom.auto_update},{value},999999999)",
                  "type": "expression"
                }
              ],
              "type": "expr"
            },
            "persistent": true
          },
          "custom.table_filtering_active": {
            "binding": {
              "config": {
                "struct": {
                  "columns": "{this.props.columns}",
                  "filter_text": "{this.props.filter.text}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\t\n\tfilter_text \u003d value.filter_text\n\tif filter_text !\u003d \"\":\n\t\treturn True\n\t\t\n\tcolumns \u003d value.columns\n\tfilter_keys \u003d [\u0027string\u0027, \u0027number\u0027, \u0027date\u0027]\n\t\n\tfor column in columns:\n\t\t# Safely retrieve filter dictionary\n\t\tif hasattr(column, \u0027get\u0027):\n\t\t\tfilter_dict \u003d column.get(\u0027filter\u0027)\n\t\telse:\n\t\t\tfilter_dict \u003d getattr(column, \u0027filter\u0027, None)\n\t\t\n\t\tif filter_dict:\n\t\t\tfor f_key in filter_keys:\n\t\t\t\tif f_key in filter_dict:\n\t\t\t\t\tsub_filter \u003d filter_dict[f_key]\n\t\t\t\t\t\n\t\t\t\t\t# Safely retrieve sub-filter value\n\t\t\t\t\tif hasattr(sub_filter, \u0027get\u0027):\n\t\t\t\t\t\tval \u003d sub_filter.get(\u0027value\u0027)\n\t\t\t\t\telse:\n\t\t\t\t\t\tval \u003d getattr(sub_filter, \u0027value\u0027, \u0027\u0027)\n\t\t\t\t\t\n\t\t\t\t\t# Check if filter has active user input\n\t\t\t\t\tif val is not None and str(val) !\u003d \"\":\n\t\t\t\t\t\treturn True\n\t\t\t\t\t\t\n\treturn False",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            },
            "persistent": true
          },
          "props.data": {
            "binding": {
              "config": {
                "mode": "direct",
                "parameters": {
                  "comment": "{session.custom.scriptProfiler.queryPayload.commentFilter}",
                  "date_end": "{session.custom.scriptProfiler.filters.dateEnd}",
                  "date_start": "{session.custom.scriptProfiler.filters.dateStart}",
                  "limit": "{view.custom.query_limit}",
                  "script_name": "{session.custom.scriptProfiler.queryPayload.scriptName}",
