          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\t\n\tself.parent.parent.getChild(\"Table\").props.filter.text \u003d \u0027\u0027\n\t\n\tcolumns \u003d self.parent.parent.getChild(\"Table\").props.columns\n\tdefault_filter \u003d {\n\t    \"enabled\": True,\n\t    \"visible\": \"always\",\n\t    \"string\": {\"condition\": \"\", \"value\": \"\"},\n\t    \"number\": {\"condition\": \"\", \"value\": \"\"},\n\t    \"boolean\": {\"condition\": \"\"},\n\t    \"date\": {\"condition\": \"\", \"value\": \"\"}\n\t}\n\t\n\tupdated_columns \u003d []\n\tfor col in columns:\n\t    col_dict \u003d dict(col)\n\t    col_dict[\"filter\"] \u003d default_filter\n\t    updated_columns.append(col_dict)\n\n\tself.parent.parent.getChild(\"Table\").props.columns \u003d updated_columns"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
