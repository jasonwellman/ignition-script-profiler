            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\timport random\n\timport time\n\t\n\t@scriptProfiler.profiler(script_type\u003d\"General Script\", capture_stack\u003dTrue, comment\u003d\"Random outcome test\")\n\tdef simulated_process():\n\t\t# 1. Simulate varying execution time (between 10ms and 300ms)\n\t\ttime.sleep(random.uniform(0.01, 0.3))\n\t\t\n\t\t# 2. Simulate a 30% chance of failure\n\t\tif random.random() \u003c 0.3:\n\t\t\traise Exception(\"Simulated processing error: Database connection timed out\")\n\t\t\n\t\treturn \"Process completed successfully\"\n\t\n\ttry:\n\t\tself.props.enabled \u003d False\n\t\tsimulated_process()\n\texcept Exception:\n\t\tpass\n\tfinally:\n\t\tself.props.enabled \u003d True"
                  },
                  "scope": "G",
                  "type": "script"
                }
              },
              "system": {
                "onStartup": {
                  "config": {
                    "script": "\tself.props.enabled \u003d True"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Test",
              "tooltip": {
                "delay": 0,
                "enabled": true,
                "location": "bottom-right",
                "text": "Generate a \u0027Random outcome test\u0027 log"
              }
            },
