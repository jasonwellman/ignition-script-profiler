{
  "custom": {
    "number_of_logs": 5000,
    "query_auto_update": false,
    "query_limit": 5000
  },
  "params": {},
  "propConfig": {
    "custom.number_of_logs": {
      "binding": {
        "config": {
          "expression": "if(isGood({/root/TimeSeriesChart.props.series[0].data}),\r\n\tlen({/root/TimeSeriesChart.props.series[0].data}),\r\n\t0\r\n)"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.query_auto_update": {
      "persistent": true
    },
    "custom.query_limit": {
      "binding": {
        "config": {
          "path": "session.custom.scriptProfiler.querySettings.limit"
        },
        "type": "property"
      },
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 1200
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "children": [
              {
                "meta": {
                  "name": "Label_Total",
                  "tooltip": {
                    "delay": 0,
                    "location": "bottom-left",
                    "text": "Query limit reach. Please adjust your filters or increase the limit in the settings."
                  }
                },
                "position": {
                  "shrink": 0
                },
                "propConfig": {
                  "custom.log_limit_reached": {
                    "binding": {
                      "config": {
                        "expression": "{view.custom.number_of_logs}\u003e\u003d{view.custom.query_limit}"
                      },
                      "type": "expr"
                    }
                  },
                  "meta.tooltip.enabled": {
                    "binding": {
                      "config": {
                        "path": "this.custom.log_limit_reached"
                      },
                      "type": "property"
                    }
                  },
                  "props.style.color": {
                    "binding": {
                      "config": {
                        "expression": "if({this.custom.log_limit_reached},\r\n\t\"--error\",\r\n\t\"\"\r\n)"
                      },
                      "type": "expr"
                    }
                  },
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": " \"TOTAL LOGS: \" + {view.custom.number_of_logs}"
                      },
                      "overlayOptOut": true,
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "fontSize": "1.2em",
                    "fontWeight": "bold"
                  }
                },
                "type": "ia.display.label"
              },
              {
                "custom": {
                  "time_calculation": 999999993
                },
                "meta": {
                  "name": "Label_Updating"
                },
                "position": {
                  "basis": "32px",
                  "grow": 1
                },
                "propConfig": {
                  "custom.time_calculation": {
                    "binding": {
                      "config": {
                        "expression": "round(millisBetween(now(150),addSeconds({..../TimeSeriesChart.custom.query_last_execution},{..../TimeSeriesChart.custom.query_polling}))/1000,1)"
                      },
                      "overlayOptOut": true,
                      "type": "expr"
                    },
                    "persistent": true
                  },
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "if({view.custom.query_auto_update}\u003dtrue,\r\n\tif({this.custom.time_calculation}\u003e\u003d0,\r\n\t\t\u0027Updating in \u0027 + {this.custom.time_calculation} + \u0027 seconds\u0027,\r\n\t\t\u0027Updating now...\u0027),\t\t\r\n\t\u0027Auto Update Disabled\u0027\r\n)"
                      },
                      "type": "expr"
                    },
                    "persistent": true
                  }
                },
                "props": {
                  "style": {
                    "fontSize": "0.75em"
                  },
                  "text": "Auto Update Disabled"
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "FlexContainer_Info"
            },
            "position": {
              "grow": 1
            },
            "props": {
              "direction": "column",
              "style": {
                "overflow": "visible"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tself.view.custom.query_auto_update \u003d not self.view.custom.query_auto_update"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Auto_Update",
              "tooltip": {
                "delay": 0,
                "enabled": true,
                "location": "bottom-right",
                "text": "Turn on/off auto updating table."
              }
            },
            "position": {
              "basis": "40px",
              "shrink": 0
            },
            "propConfig": {
              "props.primary": {
                "binding": {
                  "config": {
                    "path": "view.custom.query_auto_update"
                  },
                  "type": "property"
                }
              },
              "props.style.backgroundColor": {
                "binding": {
                  "config": {
                    "path": "view.custom.query_auto_update"
                  },
                  "transforms": [
                    {
                      "fallback": "",
                      "inputType": "scalar",
                      "mappings": [
                        {
                          "input": true,
                          "output": "--qual-7"
                        }
                      ],
                      "outputType": "scalar",
                      "type": "map"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "image": {
                "icon": {
                  "path": "material/refresh"
                }
              },
              "style": {
                "fontSize": "1em",
                "marginLeft": 5
              },
              "text": ""
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "FlexContainer_Header"
        },
        "position": {
          "basis": "50px",
          "shrink": 0
        },
        "props": {
          "style": {
            "overflow": "visible",
            "padding": 5
          }
        },
        "type": "ia.container.flex"
      },
      {
        "custom": {
          "query_last_execution": {
            "$": [
              "ts",
              192,
              1792541665686
            ],
            "$ts": 1792541665686
          },
          "query_polling": 999999999
        },
        "meta": {
          "name": "TimeSeriesChart"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "custom.query_polling": {
            "binding": {
              "config": {
                "expression": "len({this.props.series[0].data})"
              },
              "transforms": [
                {
                  "fallback": 60,
                  "inputType": "range",
                  "mappings": [
                    {
                      "input": {
                        "max": 1000,
                        "min": 0
                      },
                      "output": 1
                    },
                    {
                      "input": {
                        "max": 5000,
                        "min": 1001
                      },
                      "output": 5
                    },
                    {
                      "input": {
                        "max": 10000,
                        "min": 5000
                      },
                      "output": 15
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                },
                {
                  "expression": "if({view.custom.query_auto_update},{value},999999999)",
                  "type": "expression"
                }
              ],
              "type": "expr"
            },
            "persistent": true
          },
          "props.series[0].data": {
            "binding": {
              "config": {
                "mode": "direct",
                "parameters": {
                  "date_end": "{session.custom.scriptProfiler.filters.dateEnd}",
                  "date_start": "{session.custom.scriptProfiler.filters.dateStart}",
                  "limit": "{view.custom.query_limit}",
                  "script_name": "{session.custom.scriptProfiler.queryPayload.scriptName}",
                  "script_type": "{session.custom.scriptProfiler.queryPayload.scriptType}"
                },
                "polling": {
                  "enabled": true,
                  "rate": "{this.custom.query_polling}"
                },
                "queryPath": "scriptProfiler/getTimeSeriesExecutionLogs",
                "returnFormat": "dataset"
              },
              "transforms": [
                {
                  "code": "\t\n\tdef update_query_last_execution():\n\t\tself.custom.query_last_execution \u003d system.date.now()\n\t\n\tif value is None or value.rowCount \u003d\u003d 0:\n\t\tupdate_query_last_execution()\n\t\treturn value\n\t\n\tdataset \u003d system.dataset.sort(value, \u0027t_stamp\u0027, True)\n\tpy_data \u003d system.dataset.toPyDataSet(dataset)\n\t\n\t# Extract unique script names dynamically\n\tunique_scripts \u003d sorted(list(set(row[\"script_name\"] for row in py_data)))\n\theaders \u003d [\"t_stamp\"] + unique_scripts\n\t# Build pivoted rows with nulls for inactive series on each timestamp\n\trows \u003d []\n\tfor row in py_data:\n\t\tt_stamp \u003d row[\"t_stamp\"]\n\t\ts_name \u003d row[\"script_name\"]\n\t\tduration \u003d row[\"duration_ms\"]\n\t\t\n\t\tnew_row \u003d [t_stamp] + [duration if name \u003d\u003d s_name else None for name in unique_scripts]\n\t\trows.append(new_row)\n\t\t\n\tupdate_query_last_execution()\n\treturn system.dataset.toDataSet(headers, rows)",
                  "type": "script"
                }
              ],
              "type": "query"
            }
          }
        },
        "props": {
          "autoGenerateSeriesNames": true,
          "defaultStyles": {
            "colorScheme": "Spectral"
          },
          "legend": {
            "position": "right",
            "visible": true
          },
          "plots": [
            {
              "axes": [
                {
                  "alignment": "left",
                  "grid": {
                    "color": "",
                    "dashArray": 0,
                    "opacity": 0.2,
                    "style": {
                      "classes": ""
                    },
                    "visible": true
                  },
                  "label": {
                    "font": {
                      "size": 14
                    },
                    "offset": 0,
                    "style": {
                      "classes": "",
                      "fontWeight": "bold"
                    },
                    "text": "Execution Time (ms)",
                    "visible": true
                  },
                  "max": "",
                  "min": "",
                  "name": "default",
                  "style": {
                    "classes": ""
                  },
                  "tick": {
                    "count": "Auto",
                    "label": {
                      "font": {
                        "size": 10
                      },
                      "format": "Auto",
                      "style": {
                        "classes": ""
                      }
                    },
                    "style": {
                      "classes": ""
                    }
                  },
                  "width": 60
                }
              ],
              "markers": [],
              "relativeWeight": 1,
              "trends": [
                {
                  "axis": "default",
                  "baselines": [],
                  "breakLine": true,
                  "columns": [],
                  "interpolation": "curveStepAfter",
                  "radius": 3,
                  "series": "series",
                  "stack": true,
                  "type": "scatter",
                  "visible": true
                }
              ]
            }
          ],
          "series": [
            {
              "name": "series"
            }
          ],
          "timeAxis": {
            "grid": {
              "opacity": 0.025,
              "visible": true
            },
            "tick": {
              "label": {
                "format": "MMM D h:mm:ss a"
              }
            }
          },
          "timeRange": {
            "timeFormat": "h:mm:ss a"
          }
        },
        "type": "ia.chart.timeseries"
      }
    ],
    "events": {
      "system": {
        "onStartup": {
          "config": {
            "script": "\tself.view.custom.number_of_logs \u003d 0"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}